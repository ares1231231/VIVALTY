# Redis (optional; falls back to LocMem cache if unset)
REDIS_URL=redis://127.0.0.1:6379/1

# AI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
