# ───────────────────────────────────────────────────────────────────────────
# Django core
# ───────────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme + host) for any browser POSTing to your domain.
# Required in production. Example: https://vivalty.com,https://www.vivalty.com
CSRF_TRUSTED_ORIGINS=
# Used to build absolute URLs in outgoing emails (verify, reset, etc).
SITE_URL=http://localhost:8000
# CORS for the Next.js / API frontend (only if you serve one)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ───────────────────────────────────────────────────────────────────────────
# Postgres
# ───────────────────────────────────────────────────────────────────────────
POSTGRES_DB=vivalty
POSTGRES_USER=vivalty
POSTGRES_PASSWORD=vivalty
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ───────────────────────────────────────────────────────────────────────────
# Redis (optional; falls back to LocMem cache if unset — but rate-limits
# only work across processes when Redis is configured)
# ───────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/1

# ───────────────────────────────────────────────────────────────────────────
# Transactional email — Resend
# Sign up at resend.com, verify your sending domain, paste the key here.
# Leave RESEND_API_KEY empty in dev to print emails to the console instead.
# ───────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Vivalty <noreply@vivalty.com>
EMAIL_VERIFY_TIMEOUT_HOURS=48

# ───────────────────────────────────────────────────────────────────────────
# Listing scraper (Scrapy) — optional
# Kyero / custom feeds → python manage.py scrape_listings
# ───────────────────────────────────────────────────────────────────────────
# SCRAPER_PROXY=http://user:pass@host:port
# SCRAPER_OBEY_ROBOTS=0
# SCRAPER_USER_AGENT=VivaltyListingBot/1.0 (+https://vivalty.com)
# SCRAPER_DOWNLOAD_DELAY=1.5
# SCRAPER_LOG_LEVEL=INFO
# Get a free site key + secret at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both blank in dev to disable the challenge entirely.
# ───────────────────────────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ───────────────────────────────────────────────────────────────────────────
# Stripe — billing (featured boosts + owner subscriptions)
# Prefer a restricted key (rk_...) over the full secret key.
# Webhook: point Stripe at https://<your-domain>/billing/webhook/ and paste
# the signing secret below. Leave empty in dev to disable billing gracefully.
# ───────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# FEATURED_BOOST_PRICE_EUR=29
# FEATURED_BOOST_DAYS=14

# ───────────────────────────────────────────────────────────────────────────
# AI
# ───────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ───────────────────────────────────────────────────────────────────────────
# Media uploads (Cloudflare R2 or AWS S3) — required on Railway for photos
# Leave AWS_STORAGE_BUCKET_NAME empty in local dev (files go to ./media/).
# R2: https://developers.cloudflare.com/r2/
# ───────────────────────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=vivalty-media
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# Public URL for uploaded images (R2 custom domain or r2.dev public bucket URL):
# AWS_S3_CUSTOM_DOMAIN=media.vivalty.com

# Canonical hostname (www redirects to apex in production)
# CANONICAL_HOST=vivalty.com

# Company / legal (shown on footer and policy pages — required for ad-platform review)
# COMPANY_LEGAL_NAME=NovaDigital Global LLC
# COMPANY_REGISTERED_ADDRESS=30 N Gould St Ste R, Sheridan, WY 82801, United States
# COMPANY_SUPPORT_EMAIL=contact@vivalty.com
# COMPANY_INVESTOR_EMAIL=contact@vivalty.com
# COMPANY_EIN=98-1950360
# COMPANY_PHONE=+1 913-420-5346
# COMPANY_WHATSAPP=19134205346
# COMPANY_STATE_OF_FORMATION=Wyoming, United States
# COMPANY_FILING_ID=2026-002016024
# COMPANY_VAT_NUMBER=

# ───────────────────────────────────────────────────────────────────────────
# Security (production only — defaults are safe)
# ───────────────────────────────────────────────────────────────────────────
# SECURE_SSL_REDIRECT=1
