{
  "name": "vivalty-css",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind build pipeline for the Django website. Used at dev time only; production runs Python.",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ../static/css/tailwind.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ../static/css/tailwind.css --watch"
  },
  "devDependencies": {
    "flowbite": "^2.5.2",
    "tailwindcss": "^3.4.7"
  }
}
